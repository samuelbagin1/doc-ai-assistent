# LLM na tvorbu návrhu, reformuláciu a verifikáciu
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Embeddingy a webový fallback
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_WEB_MODEL=gpt-5.6-terra

# openai | local
EMBEDDING_PROVIDER=openai
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Bezpečný default: lokálna extrakcia. Hodnota hosted pošle skenovaný PDF do Firecrawl.
OCR_MODE=reject
FIRECRAWL_API_KEY=

FILES_DIR=files
DATA_DIR=data
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=document_chunks
TOP_K=5
CHUNK_SIZE=1400
CHUNK_OVERLAP=180
MAX_RETRIEVAL_ATTEMPTS=2
MIN_RETRIEVAL_SCORE=0.25
MIN_ANSWER_CONFIDENCE=0.72
WEB_SEARCH_ENABLED=true

# Voliteľné prevádzkové a bezpečnostné nastavenia
TENANT_ID=local
USER_ID=cli-user
LOG_LEVEL=INFO

